<div class="layout layout--stretch bg--black">
  <div class="grid grid--cols-2 gap--none h--full">
    {% for show in trending limit: 8 %}
      <div class="h--full{% if forloop.index > 4 %} hidden portrait:visible{% endif %}">
        <img
          class="image image--contain image-dither w--full h--full"
          src="{{ show.poster }}"
          alt="{{ show.title }}"
        >
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ tv_wall_logo | base64_encode }}">
  <span class="title">TV Wall</span>
  <span class="instance">Trending TV Shows (TMDB)</span>
</div>