{% if trending.size > 0 %}
<div class="layout layout--stretch bg--black">
  <div class="grid grid--cols-5 portrait:grid--cols-4 gap--none">
    {% for show in trending limit: 10 %}
      <div class="h--full">
        <img
          class="image image--contain image-dither w--full h--full"
          src="{{ show.poster }}"
          alt="{{ show.title }}"
        >
      </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="data:image/svg+xml;base64,{{ tv_wall_logo | base64_encode }}">
  <span class="title">TV Wall</span>
  <span class="instance">Trending TV Shows (TMDB)</span>
</div>
{% else %} 
<div class="layout"><span class="title">No shows available</span></div> {% endif %}